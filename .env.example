# Copy to .env.local for local runs. Never commit real values.

# LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server-only synthetic claims data. Never expose these to either browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
IDENTIFIER_HMAC_SECRET=

# Server-only sanitized post-call delivery.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Model and release versions are pinned in src/agent.py, src/prompt_v1.py,
